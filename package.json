{
  "name": "pulseos-hospital-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PulseOS Web-Based Hospital Management System (SLIIT SE2030 Group 60)",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev -- --host 0.0.0.0 --port 3000",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview -- --host 0.0.0.0 --port 3000",
    "start": "npm --prefix frontend run preview -- --host 0.0.0.0 --port 3000",
    "lint": "npm --prefix frontend exec tsc -- -p frontend/tsconfig.json --noEmit",
    "test": "bash tests/e2e/run_tests.sh",
    "test:e2e": "bash tests/e2e/run_tests.sh",
    "test:e2e:mock": "bash tests/e2e/run_tests.sh --mock",
    "test:e2e:live": "bash tests/e2e/run_tests.sh --live"
  },
  "keywords": [
    "pulseos",
    "hospital-management",
    "sliit",
    "se2030",
    "e2e-testing"
  ],
  "author": "SLIIT SE2030 Batch 02 Group 60",
  "license": "MIT"
}
